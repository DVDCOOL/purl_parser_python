# .env.example - FILE FOR REFERENCE ONLY - DO NOT COMMIT SENSITIVE DATA!
# Replace the placeholder values with your actual configuration.

# Redis Configuration
REDIS_HOST={IP_ADDRESS_OF_API}
REDIS_PASSWORD={PASSWORD}
REDIS_PORT=6379 or {CUSTOM_PORT}

#API
API_PORT=5000 or {CUSTOM_PORT}
API_HOST={IP_ADDRESS_OF_API}

# Application Settings
WEBAPP_PORT=8080 or {CUSTOM_PORT}
WEBAPP_HOST={IP_ADDRESS_OF_LOCAL_MACHINE}

# Email Configuration
FROM_EMAIL={EMAIL_ADDRESS}

# API Settings
NUMBER_OF_LEVELS=10
TIMEOUT=60
LOCK_TTL_SECONDS=600


DB_PATH=/app/shared/database/packages.db
